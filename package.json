{
  "name": "super-agente-stadi",
  "version": "0.0.0",
  "private": true,
  "description": "Hub web para crear, organizar, ejecutar y evolucionar todos los agentes de IA de Stadibox",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "test": "pnpm -r test",
    "corpus:sync": "tsx scripts/sync-corpus.ts",
    "agents:list": "tsx scripts/agents-list.ts",
    "worker": "tsx scripts/worker-local.ts",
    "clean": "pnpm -r exec rm -rf node_modules dist .next .turbo && rm -rf node_modules"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.46.1",
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
