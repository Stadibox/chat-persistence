# Copy to .env.local and fill in. NEVER commit .env.local.

# ────── Claude CLI ──────
# El runtime spawnea el binario `claude` (Claude Code CLI). Auth la maneja el CLI
# vía el login del usuario (~/.claude/). NO usamos ANTHROPIC_API_KEY.
# Verificar con: `claude --version` (debe ser >= 2.x)
CLAUDE_BIN=claude
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6
CLAUDE_META_MODEL=claude-opus-4-7

# ────── Supabase ──────
# Crear proyecto en https://supabase.com/dashboard, luego copiar:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ────── GitHub (sync de agents/ con stadi-agents repo) ──────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_AGENTS_REPO=stadibox/stadi-agents
GITHUB_AGENTS_BRANCH=main

# ────── Auth (Google SSO restringido a @stadibox.com) ──────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=stadibox.com
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ────── Runtime ──────
# Workspace por run (donde el CLI ejecuta). Se limpia post-run.
RUN_WORKSPACE_DIR=.runs
